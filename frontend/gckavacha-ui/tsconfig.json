{
  "compilerOptions": {
    "target": "ES2020",

    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2020"
    ],

    "module": "Node16",
    "moduleResolution": "node16",

    "jsx": "react-jsx",

    "strict": true,
    "noEmit": false,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "resolveJsonModule": true,
    "isolatedModules": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },

  "include": [
    "src"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}